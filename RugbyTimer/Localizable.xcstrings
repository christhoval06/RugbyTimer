    "RUN ON THIS IPHONE INSTEAD" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USAR ESTE IPHONE EN SU LUGAR"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTILISER CET IPHONE À LA PLACE"
