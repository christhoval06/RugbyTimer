    "RUGBY TIMER %@" : {
      "shouldTranslate" : false
    },
    "Rugby Timer is a referee's match clock. Set up the match on iPhone, kick off on Apple Watch and keep your eyes on the game." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugby Timer es el reloj de partido para árbitros. Configura el partido en el iPhone, inícialo en el Apple Watch y no le quites los ojos al juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugby Timer est le chrono de match de l'arbitre. Préparez le match sur l'iPhone, donnez le coup d'envoi sur l'Apple Watch et gardez les yeux sur le jeu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rugby Timer é o relógio de jogo do árbitro. Configure o jogo no iPhone, dê o pontapé inicial no Apple Watch e mantenha os olhos no jogo."
          }
        }
      }
    },
    "RULE DEFAULTS" : {
