    "Half length, sin-bin, teams, shirt numbers, tap lock and toggles go back to their standard values." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La duración del tiempo, la exclusión, los equipos, los números de camiseta, el bloqueo de toques y los interruptores vuelven a sus valores estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durée de mi-temps, l'exclusion, les équipes, les numéros de maillot, l'anti-appui et les options reviennent à leurs valeurs standard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração do tempo, exclusão, times, números de camisa, bloqueio de toques e opções voltam aos valores padrão."
          }
        }
      }
    },
